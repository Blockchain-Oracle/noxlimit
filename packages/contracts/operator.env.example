# Copy to a local ignored file outside Git, replace every <...> value, then source it.
# This file deliberately contains no RPC credential or private key.
# - SEPOLIA_RPC_URL is required only by validate/deploy/resolve/close-liquidity.
# - SEPOLIA_OPERATOR_PRIVATE_KEY is required only by deploy/resolve/close-liquidity and must come
#   from the operator's secret manager or current shell. Never paste it into this file.

# Stable market identity and existing public infrastructure.
NOXLIMIT_ASSET='BTC/USD'
NOXLIMIT_HORIZON='1h'
# This must exactly match: Will <ASSET> be at or above $<18-decimal strike> at <ISO UTC resolution>?
NOXLIMIT_QUESTION='Will BTC/USD be at or above $65,000 at 2031-01-01T01:00:00Z?'
NOXLIMIT_MARKET_VERSION='1'
NOXLIMIT_CONDITIONAL_TOKENS='0x5f3198E99F74A9AaA82386e275395D57401C953D'
NOXLIMIT_FPMM_FACTORY='0xC3ab21B6339b4AAbA14915FC34794DbB12a8901C'
# BTC/USD: 0x1b44F3514812d835EB1BDB0acB33d3fA3351Ee43
# ETH/USD: 0x694AA1769357215DE4FAC081bf1f309aDC325306
NOXLIMIT_CHAINLINK_PROXY='<exact official proxy matching NOXLIMIT_ASSET>'
NOXLIMIT_WORKER='<hosted worker address>'
NOXLIMIT_STRIKE_PRICE_WAD='<positive 18-decimal integer>'
# RESOLVES_AT - STARTS_AT must equal the declared 1h, 4h, or 24h horizon exactly.
NOXLIMIT_STARTS_AT='<unix seconds>'
NOXLIMIT_TRADING_CLOSES_AT='<future unix seconds>'
NOXLIMIT_RESOLVES_AT='<later unix seconds>'
# Sepolia feeds are not guaranteed to update every few minutes; the live proof uses a one-hour
# accepted observation window and still selects the first adjacent observation after resolution.
NOXLIMIT_MAXIMUM_OBSERVATION_DELAY_SECONDS='3600'

# First bundle: leave both lines commented to deploy collateral and the one shared treasury.
# Later bundles: reuse both verified addresses so the product retains one funding surface.
# NOXLIMIT_COLLATERAL_ADDRESS='<deployed NLTUSDC address>'
# NOXLIMIT_FUNDING_TREASURY_ADDRESS='<deployed shared TestnetFundingTreasury address>'

# Pool, private-order monitoring, and public runtime freshness policy.
NOXLIMIT_FPMM_FEE_BPS='200'
NOXLIMIT_POOL_SEED_ATOMS='50000000'
NOXLIMIT_EVALUATION_TIMEOUT_SECONDS='120'
NOXLIMIT_PUBLICATION_TIMEOUT_SECONDS='180'
NOXLIMIT_MINIMUM_EVALUATION_INTERVAL_SECONDS='60'
NOXLIMIT_MAXIMUM_EVALUATIONS='8'
NOXLIMIT_ORACLE_MAX_AGE_SECONDS='3600'
NOXLIMIT_POOL_QUOTE_MAX_AGE_SECONDS='60'
NOXLIMIT_INDEXER_MAX_LAG_BLOCKS='6'
NOXLIMIT_EVALUATOR_HEARTBEAT_MAX_AGE_SECONDS='60'
NOXLIMIT_LOW_LIQUIDITY_DEPTH_ATOMS='50000000'

# Shared explicit user-funding policy. INITIAL values are minimum treasury balances; successor
# deployment tops an existing matching treasury only up to these minimums.
NOXLIMIT_FUNDING_NATIVE_TARGET_WEI='20000000000000000'
NOXLIMIT_FUNDING_COLLATERAL_TARGET_ATOMS='25000000'
NOXLIMIT_FUNDING_NATIVE_PER_CLAIM_WEI='20000000000000000'
NOXLIMIT_FUNDING_COLLATERAL_PER_CLAIM_ATOMS='25000000'
NOXLIMIT_FUNDING_NATIVE_LIFETIME_WEI='40000000000000000'
NOXLIMIT_FUNDING_COLLATERAL_LIFETIME_ATOMS='100000000'
NOXLIMIT_FUNDING_COOLDOWN_SECONDS='3600'
NOXLIMIT_FUNDING_INITIAL_NATIVE_WEI='100000000000000000'
NOXLIMIT_FUNDING_INITIAL_COLLATERAL_ATOMS='250000000'

# Exact source and catalog provenance. History must contain every revision from bootstrap through
# the current head, in order, and must not include the candidate this command will produce.
NOXLIMIT_CTF_COMMIT='eeefca66eb46c800a9aaab88db2064a99026fde5'
NOXLIMIT_FPMM_COMMIT='6814c0247c745680bb13298d4f0dd7f5b574d0db'
NOXLIMIT_NOX_CONTRACTS_VERSION='0.2.4'
NOXLIMIT_SOURCE_MANIFEST_REF='.thoughts/sources/source-manifest.md'
NOXLIMIT_EVIDENCE_REF='<durable deployment evidence reference>'
NOXLIMIT_CATALOG_HISTORY_PATHS_JSON='["<absolute bootstrap manifest path>"]'
NOXLIMIT_CATALOG_OUTPUT_PATH='<absolute new catalog revision candidate path>'
NOXLIMIT_EVIDENCE_OUTPUT_PATH='<absolute new bundle evidence path>'
NOXLIMIT_CONFIRMATIONS='2'

# A deployment journal is created automatically at
# <NOXLIMIT_EVIDENCE_OUTPUT_PATH>.journal.json before the first write. Submitted/confirmed steps
# resume automatically. If the process stopped in the narrow INTENT-before-hash window, inspect the
# operator account first and then provide an exact one-use action for only that step, for example:
# NOXLIMIT_DEPLOYMENT_RECOVERY_JSON='{"resolverDeployment":{"action":"ADOPT","expectedAttempt":1,"transactionHash":"0x..."}}'
# or, only after proving no transaction was broadcast:
# NOXLIMIT_DEPLOYMENT_RECOVERY_JSON='{"resolverDeployment":{"action":"RETRY","expectedAttempt":1}}'

# Read-only validation additionally needs the deployed LP owner. It uses
# NOXLIMIT_COLLATERAL_ADDRESS and NOXLIMIT_FUNDING_TREASURY_ADDRESS above.
# NOXLIMIT_LP_OWNER='<bundle LP owner address>'

# Objective resolve operator values. Use a new evidence path for a different market/action.
# NOXLIMIT_MARKET_ID='<catalog-bound market bytes32>'
# NOXLIMIT_SELECTED_ROUND_ID='<first Chainlink proxy round at or after resolution>'
# NOXLIMIT_PREDECESSOR_ROUND_ID='<verified adjacent predecessor round>'
# NOXLIMIT_RESOLUTION_EVIDENCE_OUTPUT_PATH='<absolute new resolution evidence path>'

# LP close/redeem operator values. A pre-resolution close may leave outcome positions; run again
# after resolution with a new evidence path to redeem them.
# NOXLIMIT_FPMM_ADDRESS='<FPMM address>'
# NOXLIMIT_ORDER_BOOK_ADDRESS='<market-bound OrderBook address>'
# NOXLIMIT_LP_OWNER='<deployment evidence operator/LP owner address>'
# NOXLIMIT_CONDITION_ID='<condition bytes32>'
# NOXLIMIT_LIQUIDITY_EVIDENCE_OUTPUT_PATH='<absolute new liquidity evidence path>'

# Atomic successor activation after the predecessor OrderBook close. Both IDs must already exist in
# the current catalog as ACTIVE and SUCCESSOR on the same asset/horizon axis.
# NOXLIMIT_PREDECESSOR_MARKET_ID='<current ACTIVE market bytes32>'
# NOXLIMIT_SUCCESSOR_MARKET_ID='<verified and seeded SUCCESSOR market bytes32>'
# Reuse NOXLIMIT_CATALOG_OUTPUT_PATH as a new, absent revision path.

# Never leave a confirmation value exported between actions. Set it only on the command line:
# NOXLIMIT_OPERATOR_CONFIRM=DEPLOY_SEPOLIA_BUNDLE
# NOXLIMIT_OPERATOR_CONFIRM=RESOLVE_SEPOLIA_MARKET
# NOXLIMIT_OPERATOR_CONFIRM=CLOSE_SEPOLIA_LIQUIDITY
# NOXLIMIT_OPERATOR_CONFIRM=ACTIVATE_SEPOLIA_SUCCESSOR
