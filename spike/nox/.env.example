# Optional alternative to `pnpm gate-c:prepare`. Copy this file to .env.local only if you want to
# use an existing Sepolia-only key. Never commit or paste the funded key into chat.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Optional override; the runner defaults to PublicNode's Ethereum Sepolia endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
