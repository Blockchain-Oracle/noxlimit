{
  "name": "@noxlimit/spike-nox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "22.22.3"
  },
  "scripts": {
    "build": "tsc --build",
    "compile": "hardhat compile",
    "gate-c:prepare": "node scripts/prepare-sepolia-deployer.mjs",
