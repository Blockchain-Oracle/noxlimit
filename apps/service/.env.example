NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Exact browser origin allowed by CORS. Paths and trailing slashes are normalized to the origin.
WEB_ORIGIN=http://127.0.0.1:3000
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional override; repo-relative and service-package-relative paths are both supported.
CATALOG_MANIFEST_PATH=packages/catalog/sepolia/markets.json
# Optional operator-controlled catalog pointer. This absolute path names a small UTF-8 file
# containing one absolute path to the active immutable catalog manifest. When configured it is
# authoritative at startup and is reread on every SIGHUP for an atomic verified reload.
# CATALOG_RELOAD_POINTER_PATH=/var/lib/noxlimit/catalog-current.pointer
# Required only for hosted evaluation/finalization and funding relay:
# WORKER_PRIVATE_KEY=0x<64-hex-private-key>
# FUNDING_TREASURY_ADDRESS=0x<40-hex-address>
# NOX_COMPUTE_ADDRESS=0x<40-hex-address>
# NOX_GATEWAY_URL=https://gateway.example
# NOX_SUBGRAPH_URL=https://subgraph.example
POLL_INTERVAL_MS=5000
LOG_LEVEL=info
